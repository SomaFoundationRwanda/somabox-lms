PORT=3000
# CLOUD_URL=http://localhost:2999
CLOUD_URL=https://cloud.somaglobaltalent.org/

# Database (PostgreSQL)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/somabox_lms
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=somabox_lms
PGSSL=false
PGMAXCONNECTIONS=50

# Cloud sync (scheduled outbox; see README). With neither option set, changes wait on the box.
# SYNC_URL=https://cloud.example.org/somabox/ingest
# SYNC_TOKEN=
# Or Firestore. Absolute path to the service account key; keep this file OUTSIDE the repo.
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/somabox/firebase-service-account.json
# FIRESTORE_SYNC_COLLECTION=sync_records
# SYNC_TRANSPORT=http
# SYNC_INTERVAL_MINUTES=15

# School time zone: due dates are the end of the due day in this zone (IANA name).
SCHOOL_TIMEZONE=Africa/Kigali

# Nightly backups (see docs/ops-backup-restore.md). Use a different disk than the database.
# BACKUP_DIR=/media/usb/somabox-backups

# This box's hardware identity, written at boot by scripts/linux/somabox-device-info.sh (as root).
# DEVICE_INFO_PATH=/etc/somabox/device.json

# AI summaries of Explore/Library files for learners.
# SUMMARY_DAILY_LIMIT=5      # new summaries one learner can start per day
# SUMMARY_MAX_PARTS=8        # long books are read in at most this many parts (sampled start to end)
# SUMMARY_MAX_PAGES=120      # PDF pages read
# EXPLORE_RESCAN_MINUTES=5   # how often Explore re-reads its folders
