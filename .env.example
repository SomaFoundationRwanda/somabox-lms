# SOMABOX settings, for every app (backend, frontend, AI). Copy to .env and edit:
#   cp .env.example .env
# Commented lines show the default or an example. All of this is checked when anything starts
# (@somabox/config), and a wrong value stops it with a message naming the setting.
# A .env.local next to this file overrides .env on one machine.

# ---- Ports ----------------------------------------------------------------------------------
BACKEND_PORT=3000
FRONTEND_PORT=3001
AI_GATEWAY_PORT=5000           # macOS uses 5000 for AirPlay: pick another (e.g. 5050) on a Mac
AI_RUNTIME_PORT=8080

# The address learners' browsers use to reach the backend. Unset on a development machine (it
# follows BACKEND_PORT). On a school box, the box's LAN address; it's built into the frontend,
# so run `pnpm build` after changing it. A path such as /api works behind a proxy.
# PUBLIC_BACKEND_URL=http://10.0.0.1:3000

# ---- Database (PostgreSQL) --------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/somabox_lms   # instead of PG*
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=somabox_lms
# PGSSL=false
# PGMAXCONNECTIONS=50

# ---- School and box -------------------------------------------------------------------------
# Due dates are the end of the due day in this time zone (IANA name).
SCHOOL_TIMEZONE=Africa/Kigali
# Nightly backups (docs/ops-backup-restore.md). Use a different disk than the database.
# BACKUP_DIR=/media/usb/somabox-backups
# This box's hardware identity, written at boot by scripts/linux/somabox-device-info.sh.
# DEVICE_INFO_PATH=/etc/somabox/device.json
# Signs media links; a random one is kept in the database if unset (16+ characters).
# MEDIA_SECRET=
# MEDIA_COOKIE_SECURE=false      # true only when the box is served over HTTPS

# ---- Cloud content and sync (soma-x-backend/README.md) ----------------------------------------
CLOUD_URL=https://cloud.somaglobaltalent.org/
# The box works fully offline; changes wait on it until a destination is set.
# With soma-x-server (the VPS at CLOUD_URL), register the box there and use its key:
# SYNC_URL=https://cloud.somaglobaltalent.org/api/v1/box-sync
# SYNC_TOKEN=sbx_...             # also sent when downloading cloud content (CLOUD_TOKEN overrides)
# CLOUD_TOKEN=
# Or Firestore: absolute path to the service account key, kept OUTSIDE the repository.
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/somabox/firebase-service-account.json
# FIRESTORE_SYNC_COLLECTION=sync_records
# SYNC_TRANSPORT=http            # http, firestore or none; otherwise SYNC_URL wins
# SYNC_INTERVAL_MINUTES=15
# SYNC_TIMEOUT_MS=60000
# SYNC_BATCH_SIZE=200

# ---- AI ---------------------------------------------------------------------------------------
# AI_GATEWAY_URL=http://127.0.0.1:5000   # only if the gateway isn't on this machine
# AI_REQUEST_TIMEOUT_MS=300000
# AI_JOB_CONCURRENCY=1
# AI summaries of Explore/Library files for learners:
# SUMMARY_DAILY_LIMIT=5          # new summaries one learner can start per day
# SUMMARY_MAX_PARTS=8            # long books are read in at most this many parts
# SUMMARY_MAX_PAGES=120          # PDF pages read

# ---- Explore ----------------------------------------------------------------------------------
# EXPLORE_RESCAN_MINUTES=5       # how often Explore re-reads its folders
# EXPLORE_COVERS=on              # off: don't make cover images for books and videos

# ---- Frontend features (built into the frontend) ---------------------------------------------
# NEXT_PUBLIC_FEATURE_SOL_QUIZ_ENABLED=false
