{
  "name": "somabox-lms-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SOMA-BOX LMS Monorepo (Frontend + Backend)",
  "scripts": {
    "dev": "node scripts/somabox.mjs dev",
    "dev:all": "node scripts/somabox.mjs dev:all",
    "dev:ai": "node scripts/somabox.mjs dev:ai",
    "build": "node scripts/somabox.mjs build",
    "start": "node scripts/somabox.mjs check && pm2 start ecosystem.config.cjs",
    "setup:db": "pnpm --filter soma-x-backend run setup",
    "setup:code": "pnpm --filter soma-x-backend run setup:code",
    "pm2:start": "node scripts/somabox.mjs check && pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "test": "pnpm -r --if-present test",
    "backup": "pnpm --filter soma-x-backend run backup",
    "test:e2e": "playwright test -c e2e/playwright.config.mjs",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.mjs --ui",
    "restore": "pnpm --filter soma-x-backend run restore",
    "backup:verify": "pnpm --filter soma-x-backend run backup:verify",
    "env:migrate": "node scripts/somabox.mjs env:migrate"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@somabox/config": "workspace:*",
    "concurrently": "^9.2.4",
    "pm2": "^5.4.3"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^25.0.0",
    "pnpm": ">=10"
  }
}
