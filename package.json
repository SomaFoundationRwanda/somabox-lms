{
  "name": "somabox-lms-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SOMA-BOX LMS Monorepo (Frontend + Backend)",
  "workspaces": [
    "shared/*",
    "soma-x",
    "soma-x-backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND,AI-MODEL,AI-GATEWAY\" -c \"cyan,magenta,yellow,green\" \"npm run dev --workspace=soma-x-backend\" \"npm run dev --workspace=soma-x\" \"npm run ai:runtime\" \"npm run ai:gateway\"",
    "dev:app": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev --workspace=soma-x-backend\" \"npm run dev --workspace=soma-x\"",
    "dev:ai": "concurrently -n \"AI-MODEL,AI-GATEWAY\" -c \"yellow,green\" \"npm run ai:runtime\" \"npm run ai:gateway\"",
    "ai:runtime": "./ai/runtime/start_runtime.sh",
    "ai:gateway": "npm start --prefix ai/gateway",
    "build": "npm run build --workspace=soma-x",
    "start": "pm2 start ecosystem.config.cjs",
    "start:dev": "npm run dev",
    "setup:db": "npm run setup --workspace=soma-x-backend",
    "migrate:sqlite-to-pg": "node soma-x-backend/src/scripts/migrate-sqlite-to-pg.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "test": "npm test --workspaces --if-present && npm test --prefix ai/gateway",
    "backup": "npm run backup --workspace=soma-x-backend --",
    "test:e2e": "playwright test -c e2e/playwright.config.mjs",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.mjs --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.2.4",
    "pm2": "^5.4.3"
  }
}
