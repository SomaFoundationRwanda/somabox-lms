{
  "name": "somabox-lms-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SOMA-BOX LMS Monorepo (Frontend + Backend)",
  "workspaces": [
    "soma-x",
    "soma-x-backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev --workspace=soma-x-backend\" \"npm run dev --workspace=soma-x\"",
    "build": "npm run build --workspace=soma-x",
    "start": "pm2 start ecosystem.config.cjs",
    "start:dev": "npm run dev",
    "setup:db": "npm run setup --workspace=soma-x-backend",
    "migrate:sqlite-to-pg": "node soma-x-backend/src/scripts/migrate-sqlite-to-pg.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "pm2": "^5.4.3"
  }
}
