{
  "name": "somabox-lms-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SOMA-BOX LMS Monorepo (Frontend + Backend)",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"pnpm --filter soma-x-backend run dev\" \"pnpm --filter soma-x run dev\"",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND,AI-MODEL,AI-GATEWAY\" -c \"cyan,magenta,yellow,green\" \"pnpm --filter soma-x-backend run dev\" \"pnpm --filter soma-x run dev\" \"pnpm ai:runtime\" \"pnpm ai:gateway\"",
    "dev:ai": "concurrently -n \"AI-MODEL,AI-GATEWAY\" -c \"yellow,green\" \"pnpm ai:runtime\" \"pnpm ai:gateway\"",
    "ai:runtime": "./ai/runtime/start_runtime.sh",
    "ai:gateway": "pnpm --filter ai-gateway run start",
    "build": "pnpm --filter soma-x run build",
    "start": "pm2 start ecosystem.config.cjs",
    "setup:db": "pnpm --filter soma-x-backend run setup",
    "migrate:sqlite-to-pg": "node soma-x-backend/src/scripts/migrate-sqlite-to-pg.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "test": "pnpm -r --if-present test",
    "backup": "pnpm --filter soma-x-backend run backup",
    "test:e2e": "playwright test -c e2e/playwright.config.mjs",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.mjs --ui",
    "restore": "pnpm --filter soma-x-backend run restore",
    "backup:verify": "pnpm --filter soma-x-backend run backup:verify"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.2.4",
    "pm2": "^5.4.3"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
